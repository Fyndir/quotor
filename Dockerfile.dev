# Image de développement : Elixir + outils média (ffmpeg, yt-dlp, whisper.cpp)

ARG WHISPER_VERSION=v1.9.5

# whisper.cpp (transcription vocale), compilé à part : seul le binaire est copié
FROM debian:trixie-slim AS whisper
ARG WHISPER_VERSION
RUN apt-get update -y \
    && apt-get install -y --no-install-recommends build-essential cmake git ca-certificates \
    && git clone --depth 1 --branch ${WHISPER_VERSION} https://github.com/ggml-org/whisper.cpp /src \
    && cmake -S /src -B /build -DCMAKE_BUILD_TYPE=Release -DBUILD_SHARED_LIBS=OFF \
         -DGGML_NATIVE=OFF -DWHISPER_BUILD_TESTS=OFF -DWHISPER_BUILD_SERVER=OFF \
    && cmake --build /build -j "$(nproc)" --target whisper-cli \
    && cp /build/bin/whisper-cli /usr/local/bin/whisper-cli

FROM elixir:1.19

RUN apt-get update -y && apt-get install -y --no-install-recommends \
      build-essential git inotify-tools ffmpeg python3 curl ca-certificates postgresql-client fonts-dejavu-core espeak-ng libgomp1 \
    && curl -fsSL https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp -o /usr/local/bin/yt-dlp \
    && chmod a+rx /usr/local/bin/yt-dlp \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

COPY --from=whisper /usr/local/bin/whisper-cli /usr/local/bin/whisper-cli

RUN mix local.hex --force && mix local.rebar --force

WORKDIR /app
ENV MIX_HOME=/root/.mix
